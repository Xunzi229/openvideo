<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Storage permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network (for future online playback) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".OpenVideoApp"
        android:allowBackup="false"
        android:banner="@drawable/bg_tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenVideo"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- Preserve the published launcher and external-intent component name. -->
        <activity-alias
            android:name="com.example.openvideo.ui.MainActivity"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="rtsp" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.player.PlayerActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:screenOrientation="unspecified"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.OpenVideo.Player" />

        <activity
            android:name=".ui.player.CompatibilityPlayerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.OpenVideo.Player" />

        <activity
            android:name=".ui.player.PlayerDisplaySettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenVideo" />

        <activity
            android:name=".ui.player.PlayerPlaybackSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenVideo" />

        <activity
            android:name=".ui.player.PlayerAudioSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenVideo" />

        <activity
            android:name=".ui.player.PlayerSubtitleSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenVideo" />

        <activity
            android:name=".ui.player.PlayerGestureSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenVideo" />

        <activity
            android:name=".ui.settings.NotificationSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenVideo" />

        <!-- Existing task and notification intents can still target the previous names. -->
        <activity-alias
            android:name="com.example.openvideo.ui.player.PlayerActivity"
            android:targetActivity=".ui.player.PlayerActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.player.CompatibilityPlayerActivity"
            android:targetActivity=".ui.player.CompatibilityPlayerActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.player.PlayerDisplaySettingsActivity"
            android:targetActivity=".ui.player.PlayerDisplaySettingsActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.player.PlayerPlaybackSettingsActivity"
            android:targetActivity=".ui.player.PlayerPlaybackSettingsActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.player.PlayerAudioSettingsActivity"
            android:targetActivity=".ui.player.PlayerAudioSettingsActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.player.PlayerSubtitleSettingsActivity"
            android:targetActivity=".ui.player.PlayerSubtitleSettingsActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.player.PlayerGestureSettingsActivity"
            android:targetActivity=".ui.player.PlayerGestureSettingsActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.example.openvideo.ui.settings.NotificationSettingsActivity"
            android:targetActivity=".ui.settings.NotificationSettingsActivity"
            android:exported="false" />

        <service
            android:name=".core.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

    </application>

</manifest>
