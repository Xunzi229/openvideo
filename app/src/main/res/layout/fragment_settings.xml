<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_lg"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_page_title"
            style="@style/TextAppearance.OpenVideo.LargeTitle" />

        <LinearLayout
            android:id="@+id/settings_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_primary_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- General Section -->
        <TextView
            android:id="@+id/settings_general_section_title"
            style="@style/TextAppearance.OpenVideo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_lg"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_section_general" />

        <LinearLayout
            style="@style/Widget.OpenVideo.GroupedSection">

        <!-- Theme -->
        <LinearLayout
            android:id="@+id/row_theme"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_theme"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_theme_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_system"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_theme"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <!-- Language -->
        <LinearLayout
            android:id="@+id/row_language"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_language"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_language_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_language_system"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_language"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/row_notifications"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_notifications"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_notifications"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        </LinearLayout>

        <!-- Backup Section (hidden until Web backup UX; see SettingsBackupUiPolicy) -->
        <LinearLayout
            android:id="@+id/settings_backup_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_xl"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_section_backup"
            style="@style/TextAppearance.OpenVideo.Section" />

        <LinearLayout
            style="@style/Widget.OpenVideo.GroupedSection">

        <!-- Export Settings -->
        <LinearLayout
            android:id="@+id/row_export_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_export_settings"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <!-- Import Settings -->
        <LinearLayout
            android:id="@+id/row_import_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_import_settings"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        </LinearLayout>

        </LinearLayout>

        <!-- Player Section -->
        <TextView
            style="@style/TextAppearance.OpenVideo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_xl"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_section_player" />

        <LinearLayout style="@style/Widget.OpenVideo.GroupedSection">

        <LinearLayout
            android:id="@+id/row_default_ratio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_default_ratio"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_default_ratio"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_ratio_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_ratio_default"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <LinearLayout
            android:id="@+id/row_default_speed"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_default_speed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_default_speed"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ov_divider" />

        <LinearLayout
            android:id="@+id/row_tv_subtitle_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_group_subtitle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_group_subtitle"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_tv_subtitle_settings"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/row_tv_audio_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_group_audio"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_group_audio"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_tv_audio_settings"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ov_divider"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/row_tv_sources_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/nav_sources"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_sources"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_tv_sources_settings"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            tools:visibility="visible" />

        </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_secondary_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.OpenVideo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_xl"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_section_storage" />

        <LinearLayout style="@style/Widget.OpenVideo.GroupedSection">

        <LinearLayout
            android:id="@+id/row_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_clear_cache"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_clear_cache"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_cache_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 MB"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <LinearLayout
            android:id="@+id/row_clear_history"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_clear_history"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_clear_history"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_history_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/TextAppearance.OpenVideo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_xl"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_section_about" />

        <LinearLayout style="@style/Widget.OpenVideo.GroupedSection">

        <LinearLayout
            android:id="@+id/row_check_update"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_check_update"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <View
                android:id="@+id/update_badge_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="@dimen/ov_space_sm"
                android:background="@drawable/bg_update_badge_dot"
                android:visibility="gone"
                android:contentDescription="@null" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_check_update"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <LinearLayout
            android:id="@+id/row_version"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_version"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_version"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ov_text_secondary"
                android:textSize="@dimen/ov_text_meta"
                tools:text="1.0.0" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <LinearLayout
            android:id="@+id/row_project_repo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_project_repo"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        <View
            android:id="@+id/divider_project_repo"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="@dimen/ov_space_lg"
            android:background="@color/ov_divider" />

        <LinearLayout
            android:id="@+id/row_license"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ov_row_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/settings_license"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ov_space_lg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_license"
                android:textColor="@color/ov_text_primary"
                android:textSize="@dimen/ov_text_body" />

            <ImageView style="@style/Widget.OpenVideo.Chevron" />
        </LinearLayout>

        </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
