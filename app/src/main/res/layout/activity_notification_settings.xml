<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/ov_space_page">

            <include
                android:id="@+id/btn_back"
                layout="@layout/include_apple_nav_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.OpenVideo.NavTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/settings_notifications_title" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.OpenVideo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_lg"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_section_system_notifications" />

        <LinearLayout style="@style/Widget.OpenVideo.GroupedSection">

            <LinearLayout
                android:id="@+id/row_allow_system_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ov_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ov_space_lg"
                android:paddingTop="@dimen/ov_space_sm"
                android:paddingEnd="@dimen/ov_space_md"
                android:paddingBottom="@dimen/ov_space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notification_allow_system_title"
                        android:textColor="@color/ov_text_primary"
                        android:textSize="@dimen/ov_text_body" />

                    <TextView
                        android:id="@+id/tv_allow_system_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_notification_allow_system_off"
                        android:textColor="@color/ov_text_secondary"
                        android:textSize="@dimen/ov_text_caption" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_allow_system_notifications"
                    style="@style/Widget.OpenVideo.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ov_space_md"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.OpenVideo.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ov_space_page"
            android:paddingTop="@dimen/ov_space_xl"
            android:paddingBottom="@dimen/ov_space_sm"
            android:text="@string/settings_notification_section_background_playback" />

        <LinearLayout style="@style/Widget.OpenVideo.GroupedSection">

            <LinearLayout
                android:id="@+id/row_bg_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ov_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ov_space_lg"
                android:paddingTop="@dimen/ov_space_sm"
                android:paddingEnd="@dimen/ov_space_md"
                android:paddingBottom="@dimen/ov_space_sm">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notification_bg_playback_title"
                        android:textColor="@color/ov_text_primary"
                        android:textSize="@dimen/ov_text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_notification_bg_playback_summary"
                        android:textColor="@color/ov_text_secondary"
                        android:textSize="@dimen/ov_text_caption" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_bg_notification"
                    style="@style/Widget.OpenVideo.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ov_space_md"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
