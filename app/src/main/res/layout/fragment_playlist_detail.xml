<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/ov_space_page"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/btn_back"
            layout="@layout/include_apple_nav_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/TextAppearance.OpenVideo.NavTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="8dp" />

        <ImageButton
            android:id="@+id/btn_import_playlist"
            android:layout_width="@dimen/ov_icon_button_size"
            android:layout_height="@dimen/ov_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playlist_import"
            android:src="@drawable/ic_file_upload"
            app:tint="@color/ov_text_secondary" />

        <ImageButton
            android:id="@+id/btn_export_playlist"
            android:layout_width="@dimen/ov_icon_button_size"
            android:layout_height="@dimen/ov_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playlist_export"
            android:src="@drawable/ic_file_download"
            app:tint="@color/ov_text_secondary" />

        <ImageButton
            android:id="@+id/btn_cleanup_playlist"
            android:layout_width="@dimen/ov_icon_button_size"
            android:layout_height="@dimen/ov_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playlist_cleanup"
            android:src="@drawable/ic_filter_tune"
            app:tint="@color/ov_text_secondary" />

        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="@dimen/ov_icon_button_size"
            android:layout_height="@dimen/ov_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="清空"
            android:src="@drawable/ic_delete"
            app:tint="@color/ov_text_secondary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_videos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recycler_videos"
        app:layout_constraintEnd_toEndOf="@id/recycler_videos"
        app:layout_constraintStart_toStartOf="@id/recycler_videos"
        app:layout_constraintTop_toTopOf="@id/recycler_videos">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_list"
            app:tint="@color/ov_text_tertiary" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/playlist_detail_empty"
            android:textColor="@color/ov_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/empty_hint_playlist_detail"
            android:textColor="@color/ov_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
