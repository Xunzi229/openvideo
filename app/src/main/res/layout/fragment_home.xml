<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root">

    <HorizontalScrollView
        android:id="@+id/filter_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/smart_filter_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/folder_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/folder_pin_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:text="@string/home_folder_pin_hint"
        android:textColor="@color/ov_text_tertiary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_scroll" />

    <HorizontalScrollView
        android:id="@+id/smart_filter_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/category_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/smart_filter_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ov_space_page"
        android:layout_marginTop="@dimen/ov_space_sm"
        android:layout_marginEnd="@dimen/ov_space_page"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/TextAppearance.OpenVideo.LargeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_title_video" />

        <TextView
            android:id="@+id/btn_select"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ov_icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="@dimen/ov_touch_min"
            android:paddingHorizontal="@dimen/ov_space_sm"
            android:text="@string/action_select"
            android:textColor="@color/ov_accent_blue"
            android:textSize="@dimen/ov_text_body" />

        <ImageButton
            android:id="@+id/btn_open_url"
            android:layout_width="@dimen/ov_icon_button_size"
            android:layout_height="@dimen/ov_icon_button_size"
            android:layout_marginStart="@dimen/ov_space_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_open_url"
            android:padding="7dp"
            android:src="@drawable/ic_stream"
            app:tint="@color/ov_text_secondary" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="@dimen/ov_icon_button_size"
            android:layout_height="@dimen/ov_icon_button_size"
            android:layout_marginStart="@dimen/ov_space_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/ov_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/edit_actions"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ov_space_page"
        android:paddingEnd="@dimen/ov_space_page"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_row">

        <TextView
            android:id="@+id/tv_select_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ov_text_secondary"
            android:textSize="@dimen/ov_text_caption" />

        <TextView
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/ov_space_sm"
            android:text="@string/select_all"
            android:textColor="@color/ov_accent_blue"
            android:textSize="@dimen/ov_text_body" />

        <TextView
            android:id="@+id/btn_favorite_selected"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/ov_space_sm"
            android:text="@string/favorite_selected"
            android:textColor="@color/ov_accent_blue"
            android:textSize="@dimen/ov_text_body" />

        <TextView
            android:id="@+id/btn_delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/ov_space_sm"
            android:text="@string/delete_selected"
            android:textColor="@color/ov_danger"
            android:textSize="@dimen/ov_text_body" />
    </LinearLayout>

    <EditText
        android:id="@+id/search_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/ov_search_height"
        android:layout_marginStart="@dimen/ov_space_page"
        android:layout_marginTop="@dimen/ov_space_sm"
        android:layout_marginEnd="@dimen/ov_space_page"
        android:background="@drawable/bg_search_field"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:drawableTint="@color/ov_text_tertiary"
        android:hint="@string/home_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ov_text_primary"
        android:textColorHint="@color/ov_text_tertiary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_actions" />

    <LinearLayout
        android:id="@+id/category_scroll"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/ov_space_page"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/ov_space_page"
        android:background="@drawable/bg_segmented_track"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_view">

        <TextView
            android:id="@+id/chip_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_selected"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/home_filter_all"
            android:textColor="@color/ov_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_recent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/home_filter_recent"
            android:textColor="@color/ov_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chip_favorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/home_filter_favorite"
            android:textColor="@color/ov_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sort_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/folder_pin_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_sort_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:text="@string/home_sort_by_modified"
            android:textColor="@color/ov_text_secondary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_sort_order"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_sort_order"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/ov_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_library_filter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_advanced_filters_title"
            android:padding="8dp"
            android:src="@drawable/ic_filter_tune"
            app:tint="@color/ov_text_secondary" />

        <LinearLayout
            android:id="@+id/view_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/btn_list_view"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button_selected"
                android:contentDescription="@string/home_view_list"
                android:padding="9dp"
                android:src="@drawable/ic_list"
                app:tint="@color/ov_text_primary" />

            <ImageButton
                android:id="@+id/btn_grid_view"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_button_unselected"
                android:contentDescription="@string/home_view_grid"
                android:padding="9dp"
                android:src="@drawable/ic_grid"
                app:tint="@color/ov_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/video_pages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sort_row">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_all_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="80dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_recent_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_favorite_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"
            android:visibility="gone" />
    </FrameLayout>

    <include
        layout="@layout/include_media_library_scan_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/video_pages"
        app:layout_constraintEnd_toEndOf="@id/video_pages"
        app:layout_constraintStart_toStartOf="@id/video_pages"
        app:layout_constraintTop_toTopOf="@id/video_pages" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/video_pages"
        app:layout_constraintEnd_toEndOf="@id/video_pages"
        app:layout_constraintStart_toStartOf="@id/video_pages"
        app:layout_constraintTop_toTopOf="@id/video_pages">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_movie"
            app:tint="@color/ov_text_tertiary" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:foreground="@drawable/bg_focusable_card"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/no_videos"
            android:textColor="@color/ov_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_hint_videos"
            android:textColor="@color/ov_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
