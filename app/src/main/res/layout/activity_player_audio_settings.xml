<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/ov_space_page">

        <include
            android:id="@+id/btn_back"
            layout="@layout/include_apple_nav_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp" />

        <TextView
            style="@style/TextAppearance.OpenVideo.NavTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/settings_group_audio" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_preserve_pitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="倍速不变调" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_volume_boost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音量增强" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="声道选择"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_channel_value"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="立体声"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音频延迟"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_delay_value"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="0ms" />

            <SeekBar
                android:id="@+id/sb_audio_delay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="1000"
                android:progress="0" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
