<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_root"
    android:orientation="vertical"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <include
            android:id="@+id/btn_webdav_back"
            layout="@layout/include_apple_nav_back"
            android:layout_width="wrap_content"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/tv_webdav_title"
            style="@style/TextAppearance.OpenVideo.NavTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:text="@string/webdav_browser_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_webdav_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:textColor="@color/ov_text_secondary"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/progress_webdav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_webdav_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/bg_focusable_card"
        android:gravity="center"
        android:nextFocusUp="@id/btn_webdav_back"
        android:padding="24dp"
        android:text="@string/webdav_directory_empty"
        android:textColor="@color/ov_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_webdav_entries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/btn_webdav_back"
        android:overScrollMode="never" />
</LinearLayout>
